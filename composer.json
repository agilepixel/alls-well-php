{
    "name": "agilepixel/alls-well-php",
    "description": "Connects a PHP application to All's Well as a site: reports versions, packages and security checks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["alls-well", "uptime", "monitoring", "laravel", "health", "security", "composer"],
    "homepage": "https://alls-well.io",
    "authors": [
        {
            "name": "Agile Pixel",
            "email": "hello@alls-well.io",
            "homepage": "https://agilepixel.io"
        }
    ],
    "support": {
        "email": "hello@alls-well.io",
        "issues": "https://github.com/agilepixel/alls-well-php/issues",
        "source": "https://github.com/agilepixel/alls-well-php"
    },
    "require": {
        "php": "^7.3 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "composer-runtime-api": "^2.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "justinrainbow/json-schema": "^5.2 || ^6.0",
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "squizlabs/php_codesniffer": "^3.7",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0"
    },
    "suggest": {
        "spatie/laravel-health": "Its latest stored results are reported to All's Well as checks."
    },
    "conflict": {
        "laravel/framework": "<8.0"
    },
    "autoload": {
        "psr-4": {
            "AgilePixel\\AllsWell\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgilePixel\\AllsWell\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgilePixel\\AllsWell\\Laravel\\AllsWellServiceProvider"
            ]
        }
    },
    "bin": ["bin/alls-well"],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable"
}
